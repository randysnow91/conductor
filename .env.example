# Copy this file to .env and fill in real values. .env is git-ignored.

# Which newsletter(s) to run for, and each one's EmailServer content_api_key
# (docs/R2_BUILD-SPEC.md §4.2). JSON array, one entry per newsletter.
NEWSLETTERS='[{"id":"<email_servers.id>","contentApiKey":"<content_api_key>"}]'

# EmailServer base URL (no trailing slash)
EMAIL_SERVER_URL=

# Content Builder base URL (no trailing slash), and the shared secret sent as
# the x-conductor-secret header - same value as Content Builder's own
# CONDUCTOR_ACCESS_SECRET.
CONTENT_BUILDER_URL=
CONTENT_BUILDER_ACCESS_SECRET=
